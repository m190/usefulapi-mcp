{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "bsale",
  "version": "1.11.4",
  "description": "Read Bsale products, documents and stock; manage customers, prices, receipts and payments.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/bsale/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "retail",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Bsale",
        "shortDescription": "Read Bsale products, documents and stock; manage customers, prices, receipts and payments.",
        "developerName": "UsefulAPI",
        "category": "retail",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/bsale/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "How much did we sell last month, by document type and branch?",
          "Which products are low on stock in my main branch?",
          "Does client 12.345.678-9 have unpaid invoices?"
        ]
      }
    }
  }
}

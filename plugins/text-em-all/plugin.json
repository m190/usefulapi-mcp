{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "text-em-all",
  "version": "1.41.4",
  "description": "Send and track Text-Em-All broadcasts, texts and contact lists.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/text-em-all/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "communications",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Text-Em-All",
        "shortDescription": "Send and track Text-Em-All broadcasts, texts and contact lists.",
        "developerName": "UsefulAPI",
        "category": "communications",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/text-em-all/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Show my recent broadcasts and how many people were reached.",
          "How many credits are left on my account?",
          "Which contact lists do I have, and what are their names?"
        ]
      }
    }
  }
}

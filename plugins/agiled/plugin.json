{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "agiled",
  "version": "1.1.0",
  "description": "List CRM contacts, deals, invoices and projects, and create contacts in Agiled.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/agiled/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "business-operations",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Agiled",
        "shortDescription": "List CRM contacts, deals, invoices and projects, and create contacts in Agiled.",
        "developerName": "UsefulAPI",
        "category": "business-operations",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/agiled/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List the open deals in our pipeline and their values.",
          "Show the invoices that are past their due date.",
          "Find the contact for avery@example.com and her account."
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "shippingeasy",
  "version": "1.8.0",
  "description": "List stores, search and get orders, update order status and cancel orders in ShippingEasy.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/shippingeasy/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "shipping",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ShippingEasy",
        "shortDescription": "List stores, search and get orders, update order status and cancel orders in ShippingEasy.",
        "developerName": "UsefulAPI",
        "category": "shipping",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/shippingeasy/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Show me the orders that are ready for shipment in my store.",
          "Which orders changed in the last 24 hours, and what is their status?",
          "Mark order 10234 as awaiting shipment."
        ]
      }
    }
  }
}

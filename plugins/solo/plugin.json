{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "solo",
  "version": "1.9.4",
  "description": "Read invoices, offers, payment status and the product catalog in Solo.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/solo/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "accounting",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Solo",
        "shortDescription": "Read invoices, offers, payment status and the product catalog in Solo.",
        "developerName": "UsefulAPI",
        "category": "accounting",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/solo/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List my last 20 invoices and show which ones are not paid yet.",
          "Show the line items and VAT of invoice 12-1-1.",
          "Which of my offers are still open?"
        ]
      }
    }
  }
}

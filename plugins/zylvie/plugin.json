{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "zylvie",
  "version": "1.11.4",
  "description": "Review Zylvie coupons, sales transactions and subscriptions.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/zylvie/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "digital-commerce",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Zylvie",
        "shortDescription": "Review Zylvie coupons, sales transactions and subscriptions.",
        "developerName": "UsefulAPI",
        "category": "digital-commerce",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/zylvie/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which active coupons have been redeemed most often?",
          "Show succeeded transactions for this month.",
          "List active subscriptions scheduled to cancel."
        ]
      }
    }
  }

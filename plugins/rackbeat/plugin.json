{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "rackbeat",
  "version": "1.11.9",
  "description": "Read Rackbeat products, location stock, sales orders and customer summaries.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/rackbeat/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "ecommerce",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Rackbeat",
        "shortDescription": "Read Rackbeat products, location stock, sales orders and customer summaries.",
        "developerName": "UsefulAPI",
        "category": "ecommerce",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/rackbeat/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Find products with low available stock in Rackbeat.",
          "Show stock by warehouse location for this product.",
          "Which sales orders are ready for shipping?"
        ]
      }
    }
  }
}

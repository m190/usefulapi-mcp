{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "discord",
  "version": "1.1.0",
  "description": "Read servers, channels, messages and pins; post messages as a bot in Discord.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/discord/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "chat",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Discord",
        "shortDescription": "Read servers, channels, messages and pins; post messages as a bot in Discord.",
        "developerName": "UsefulAPI",
        "category": "chat",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/discord/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which channels does our Discord server have, and which ones are for support?",
          "Show the last 50 messages in #announcements.",
          "Reply in #general that the release is delayed until Friday."
        ]
      }
    }
  }
}

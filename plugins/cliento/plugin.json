{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cliento",
  "version": "1.11.4",
  "description": "Review Cliento locations, staff, resources, services, products and stock.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/cliento/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "business-operations",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Cliento",
        "shortDescription": "Review Cliento locations, staff, resources, services, products and stock.",
        "developerName": "UsefulAPI",
        "category": "business-operations",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/cliento/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [

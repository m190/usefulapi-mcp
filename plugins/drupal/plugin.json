{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "drupal",
  "version": "1.40.4",
  "description": "Read and write Drupal JSON:API nodes, taxonomy terms, users and files.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/drupal/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "documents",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Drupal",
        "shortDescription": "Read and write Drupal JSON:API nodes, taxonomy terms, users and files.",
        "developerName": "UsefulAPI",
        "category": "documents",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/drupal/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List the 10 most recent articles on my website.",
          "Find pages on my site with 'holiday hours' in the title.",
          "What content types does my website have?"
        ]
      }
    }
  }

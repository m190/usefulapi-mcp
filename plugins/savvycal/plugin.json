{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "savvycal",
  "version": "1.40.4",
  "description": "Read and create SavvyCal scheduling links and booked events.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/savvycal/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "calendar",
    "mcp",
    "usefulapi"

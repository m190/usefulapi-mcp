  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "SavvyCal",
        "shortDescription": "Read and create SavvyCal scheduling links and booked events.",
        "developerName": "UsefulAPI",
        "category": "calendar",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/savvycal/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",

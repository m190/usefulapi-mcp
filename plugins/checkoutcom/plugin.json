{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "checkoutcom",
  "version": "1.40.4",
  "description": "Read Checkout.com payments, disputes, reports and payouts.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/checkoutcom/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "payments",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Checkout.com",
        "shortDescription": "Read Checkout.com payments, disputes, reports and payouts.",
        "developerName": "UsefulAPI",
        "category": "payments",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/checkoutcom/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Show payments from the last 7 days and how many were declined.",
          "List all open chargebacks and their response deadlines.",
          "Find the payment with reference ORDER-1042 and show its history."
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "patreon",
  "version": "1.7.1",
  "description": "Read campaigns, tiers, patrons, posts and profile details in Patreon.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/patreon/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "membership",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Patreon",
        "shortDescription": "Read campaigns, tiers, patrons, posts and profile details in Patreon.",
        "developerName": "UsefulAPI",
        "category": "membership",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/patreon/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Show my tiers and how many patrons each one has.",
          "Which patrons joined my campaign in the last 30 days?",
          "List my five most recent posts and which ones are paid."
        ]
      }
    }
  }
}

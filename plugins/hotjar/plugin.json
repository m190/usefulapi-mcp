{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "hotjar",
  "version": "1.8.0",
  "description": "Read surveys and survey responses in Hotjar.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/hotjar/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "analytics",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Hotjar",
        "shortDescription": "Read surveys and survey responses in Hotjar.",
        "developerName": "UsefulAPI",
        "category": "analytics",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/hotjar/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List the surveys on our Hotjar site and which ones are enabled.",
          "Show the 20 latest responses to our post-checkout survey.",
          "What are the questions in our NPS survey?"
        ]
      }
    }
  }
}

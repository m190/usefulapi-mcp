{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "manychat",
  "version": "1.8.0",
  "description": "Read subscribers, tags and flows, change tags and fields, and start flows in ManyChat.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/manychat/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "messaging",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ManyChat",
        "shortDescription": "Read subscribers, tags and flows, change tags and fields, and start flows in ManyChat.",
        "developerName": "UsefulAPI",
        "category": "messaging",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/manychat/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which tags does our ManyChat page have, and how many subscribers carry the 'vip' tag?",
          "Find the subscriber named Ana García and show her custom field values.",
          "Add the 'webinar-2026' tag to subscriber 501."
        ]
      }
    }
  }
}

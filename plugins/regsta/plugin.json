{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "regsta",
  "version": "1.1.0",
  "description": "Read employees, time records and planned shifts in Regsta.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/regsta/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "time-tracking",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Regsta",
        "shortDescription": "Read employees, time records and planned shifts in Regsta.",
        "developerName": "UsefulAPI",
        "category": "time-tracking",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/regsta/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Who is scheduled to work tomorrow, and in which department?",
          "Which planned shifts were cancelled in the last two weeks?",
          "How many work minutes did each employee log last week?"
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "shoprenter",
  "version": "1.0.0",
  "description": "Read products, orders, customers and categories in Shoprenter.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/shoprenter/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "ecommerce",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Shoprenter",
        "shortDescription": "Read products, orders, customers and categories in Shoprenter.",
        "developerName": "UsefulAPI",
        "category": "ecommerce",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/shoprenter/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which orders came in today, and what is their status?",
          "Show the products that are out of stock or switched off.",
          "List the customers who signed up this month."
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "paydirt",
  "version": "1.8.0",
  "description": "Read, create and update clients, projects and jobs, and log time in Paydirt.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/paydirt/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "time-tracking",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Paydirt",
        "shortDescription": "Read, create and update clients, projects and jobs, and log time in Paydirt.",
        "developerName": "UsefulAPI",
        "category": "time-tracking",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/paydirt/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List my clients and their hourly rates.",
          "Log 90 minutes on the Website Build job for today.",
          "Show all unbilled time logs from last week."
        ]
      }
    }
  }
}

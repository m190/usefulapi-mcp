{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "web3forms",
  "version": "1.8.0",
  "description": "List forms and read submissions; create submissions in Web3Forms.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/web3forms/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "forms",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Web3Forms",
        "shortDescription": "List forms and read submissions; create submissions in Web3Forms.",
        "developerName": "UsefulAPI",
        "category": "forms",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/web3forms/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Show the latest submissions of my contact form.",
          "How many submissions has each of my forms received?",
          "Find submissions that mention pricing in the message field."
        ]
      }
    }
  }
}

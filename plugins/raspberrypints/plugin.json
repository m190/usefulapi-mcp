{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "raspberrypints",
  "version": "1.5.0",
  "description": "Read taps, beers and pours; add beers and tap them in RaspberryPints.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/raspberrypints/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "Food & Beverage",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "RaspberryPints",
        "shortDescription": "Read taps, beers and pours; add beers and tap them in RaspberryPints.",
        "developerName": "UsefulAPI",
        "category": "Food & Beverage",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/raspberrypints/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which beers are on tap at our brewery right now?",
          "Show the pours recorded today and which tap each came from.",
          "Put the Hazy IPA on tap 5 with a 1984 oz keg."
        ]
      }
    }
  }
}

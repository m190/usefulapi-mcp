{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "iris-crm",
  "version": "1.2.0",
  "description": "Read leads, lead notes, merchants and users in IRIS CRM.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/iris-crm/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "crm",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "IRIS CRM",
        "shortDescription": "Read leads, lead notes, merchants and users in IRIS CRM.",
        "developerName": "UsefulAPI",
        "category": "crm",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/iris-crm/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which leads did we add this week, and who owns them?",
          "Show the notes on lead 1234, newest first.",
          "List our merchants that were created in the last 30 days."
        ]
      }
    }
  }
}

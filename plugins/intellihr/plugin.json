{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "intellihr",
  "version": "1.20.4",
  "description": "Read intelliHR people, jobs, leave, skills and training; create and update people records.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/intellihr/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "productivity",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "intelliHR",
        "shortDescription": "Read intelliHR people, jobs, leave, skills and training; create and update people records.",
        "developerName": "UsefulAPI",
        "category": "productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/intellihr/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",

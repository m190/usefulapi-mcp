{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cloudns",
  "version": "1.5.0",
  "description": "Read DNS zones, records, failover settings and monitoring checks; add TXT records in ClouDNS.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/cloudns/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "dns",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ClouDNS",
        "shortDescription": "Read DNS zones, records, failover settings and monitoring checks; add TXT records in ClouDNS.",
        "developerName": "UsefulAPI",
        "category": "dns",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/cloudns/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which DNS zones do I manage in ClouDNS?",
          "Show the TXT records on _dmarc.example.com.",
          "Add a TXT record for my domain verification code with a 1 hour TTL."
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "clinicaltrialsgov",
  "version": "1.41.4",
  "description": "Search and read ClinicalTrials.gov studies, sites and outcomes.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/clinicaltrialsgov/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "health-data",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ClinicalTrials.gov",
        "shortDescription": "Search and read ClinicalTrials.gov studies, sites and outcomes.",
        "developerName": "UsefulAPI",
        "category": "health-data",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/clinicaltrialsgov/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Find recruiting trials for type 2 diabetes in Ohio.",
          "How many trials are registered for migraine treatment?",
          "Show me the full details and eligibility rules for trial NCT04280705."
        ]
      }
    }
  }
}

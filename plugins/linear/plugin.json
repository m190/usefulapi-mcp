{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "linear",
  "version": "1.40.5",
  "description": "Search, read and create Linear issues, projects, teams and cycles.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/linear/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "project-management",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Linear",
        "shortDescription": "Search, read and create Linear issues, projects, teams and cycles.",
        "developerName": "UsefulAPI",
        "category": "project-management",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/linear/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "What issues are assigned to me right now?",
          "Which Engineering team issues are currently In Progress?",
          "What is the progress on each of my active projects?"
        ]
      }
    }
  }
}

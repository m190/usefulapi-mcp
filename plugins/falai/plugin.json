{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "falai",
  "version": "1.40.4",
  "description": "Run fal.ai models, poll the inference queue and read model schemas.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/falai/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "image-generation",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "fal.ai",
        "shortDescription": "Run fal.ai models, poll the inference queue and read model schemas.",
        "developerName": "UsefulAPI",
        "category": "image-generation",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/falai/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which image generation models are available?",
          "What inputs does a given model need to make an image?",
          "Which models can turn a text description into a short video?"
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wubook",
  "version": "1.15.5",
  "description": "Read WuBook ZaK rooms, availability and reservations; manage inventory and guest check-in.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/wubook/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "productivity",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "WuBook",
        "shortDescription": "Read WuBook ZaK rooms, availability and reservations; manage inventory and guest check-in.",
        "developerName": "UsefulAPI",
        "category": "productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/wubook/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which rooms are available from 12 to 15 November?",
          "Show today's arrivals and departures.",
          "What is the reservation XY-0123 and how much has been paid?"
        ]
      }
    }
  }
}

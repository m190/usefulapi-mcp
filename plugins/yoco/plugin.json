{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "yoco",
  "version": "1.1.0",
  "description": "Read payments, orders, refunds and payouts; create or delete payment links in Yoco.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/yoco/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "payments",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Yoco",
        "shortDescription": "Read payments, orders, refunds and payouts; create or delete payment links in Yoco.",
        "developerName": "UsefulAPI",
        "category": "payments",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/yoco/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Show me the last 10 successful payments.",
          "Which orders are still open at the Main location?",
          "List the refunds from last week and their status."
        ]
      }
    }
  }
}

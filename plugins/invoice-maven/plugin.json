{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "invoice-maven",
  "version": "1.2.0",
  "description": "Search existing fiscal documents without creating or cancelling any, in Invoice Maven.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/invoice-maven/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "billing",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Invoice Maven",
        "shortDescription": "Search existing fiscal documents without creating or cancelling any, in Invoice Maven.",
        "developerName": "UsefulAPI",
        "category": "billing",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/invoice-maven/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Show me the Invoice Maven records available to my account."
        ]
      }
    }
  }
}

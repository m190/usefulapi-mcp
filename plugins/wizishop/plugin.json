{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wizishop",
  "version": "1.1.0",
  "description": "Read products, orders, customers and categories in WiziShop.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/wizishop/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "ecommerce",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "WiziShop",
        "shortDescription": "Read products, orders, customers and categories in WiziShop.",
        "developerName": "UsefulAPI",
        "category": "ecommerce",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/wizishop/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which products are out of stock or hidden in my shop?",
          "Show the orders from the last week that are not yet shipped.",
          "Find the customer with the email address on this order."
        ]
      }
    }
  }
}

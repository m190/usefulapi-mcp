{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "staffwise",
  "version": "1.2.0",
  "description": "Read the shift details of a job over a date range in Staffwise.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/staffwise/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "scheduling",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Staffwise",
        "shortDescription": "Read the shift details of a job over a date range in Staffwise.",
        "developerName": "UsefulAPI",
        "category": "scheduling",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/staffwise/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "What shifts are booked for job 1234 between 1 and 30 November?",
          "Show me the shift report for job 1234 for last week."
        ]
      }
    }
  }
}

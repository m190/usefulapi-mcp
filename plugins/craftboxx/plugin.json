{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "craftboxx",
  "version": "1.10.4",
  "description": "Read employees, assignments, timesheets and absences; create customers and projects in Craftboxx.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/craftboxx/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "project-management",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Craftboxx",
        "shortDescription": "Read employees, assignments, timesheets and absences; create customers and projects in Craftboxx.",
        "developerName": "UsefulAPI",
        "category": "project-management",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/craftboxx/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which assignments are planned for next week, and who works on each?",
          "Show the timesheets of all employees for last month.",
          "Who is absent tomorrow?"
        ]
      }
    }
  }
}

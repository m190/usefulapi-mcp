{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "egestor",
  "version": "1.9.4",
  "description": "Read contacts, products, sales, receivables and payables; create contacts in eGestor.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/egestor/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "business-operations",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "eGestor",
        "shortDescription": "Read contacts, products, sales, receivables and payables; create contacts in eGestor.",
        "developerName": "UsefulAPI",
        "category": "business-operations",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/egestor/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which customer invoices are still open and due this month?",
          "List my sales from last week with totals.",
          "Which products do I sell, and at what price?"
        ]
      }
    }
  }
}

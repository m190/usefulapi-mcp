{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "geocodio",
  "version": "1.1.0",
  "description": "Geocode and reverse-geocode addresses, measure distances, and manage lists in Geocodio.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/geocodio/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "maps",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Geocodio",
        "shortDescription": "Geocode and reverse-geocode addresses, measure distances, and manage lists in Geocodio.",
        "developerName": "UsefulAPI",
        "category": "maps",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/geocodio/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "What are the coordinates of 1600 Pennsylvania Ave NW, Washington DC?",
          "Geocode this list of 500 customer addresses and tell me how many failed.",
          "Which address is at coordinates 38.886672, -77.094735?"
        ]
      }
    }
  }
}

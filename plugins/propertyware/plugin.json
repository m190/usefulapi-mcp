{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "propertyware",
  "version": "1.15.5",
  "description": "Read Propertyware properties, leases and work orders; add maintenance tasks and comments.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/propertyware/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "productivity",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Propertyware",
        "shortDescription": "Read Propertyware properties, leases and work orders; add maintenance tasks and comments.",
        "developerName": "UsefulAPI",
        "category": "productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/propertyware/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Find vacant properties in my portfolio.",
          "Which leases end next month?",
          "List high priority work orders."
        ]
      }
    }
  }
}

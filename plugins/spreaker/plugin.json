{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "spreaker",
  "version": "1.7.0",
  "description": "Read shows, episodes, statistics and comments; update episode details in Spreaker.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/spreaker/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "analytics",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Spreaker",
        "shortDescription": "Read shows, episodes, statistics and comments; update episode details in Spreaker.",
        "developerName": "UsefulAPI",
        "category": "analytics",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/spreaker/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List my Spreaker shows.",
          "Which episodes of my show got the most plays last month?",
          "Where do the listeners of my newest episode come from?"
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "activetrail",
  "version": "1.0.0",
  "description": "Read contacts, groups, campaigns and automations; add contacts to groups in ActiveTrail.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/activetrail/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "email-marketing",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ActiveTrail",
        "shortDescription": "Read contacts, groups, campaigns and automations; add contacts to groups in ActiveTrail.",
        "developerName": "UsefulAPI",
        "category": "email-marketing",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/activetrail/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "How many email and SMS credits does our ActiveTrail account have left?",
          "Add jane@example.com to the 'Newsletter' group.",
          "Show the open and click statistics for our last email campaign."
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "salesrabbit",
  "version": "1.5.0",
  "description": "Read leads, statuses, users and org units; create and update leads in SalesRabbit.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/salesrabbit/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "crm",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "SalesRabbit",
        "shortDescription": "Read leads, statuses, users and org units; create and update leads in SalesRabbit.",
        "developerName": "UsefulAPI",
        "category": "crm",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/salesrabbit/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which leads did our reps add this week, and who owns them?",
          "Show the status history of lead 12345.",
          "List our active users and their roles."
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "solidtime",
  "version": "1.8.0",
  "description": "Start and stop timers, log time entries, and read projects, tasks and time entries in solidtime.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/solidtime/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "time-tracking",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "solidtime",
        "shortDescription": "Start and stop timers, log time entries, and read projects, tasks and time entries in solidtime.",
        "developerName": "UsefulAPI",
        "category": "time-tracking",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/solidtime/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Start a timer for project Website, billable, with the description 'Homepage copy'.",
          "What did I track last week, grouped by project?",
          "Stop my running timer."
        ]
      }
    }
  }
}

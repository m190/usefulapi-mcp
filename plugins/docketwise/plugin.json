{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "docketwise",
  "version": "1.6.0",
  "description": "Read contacts, matters, invoices and documents; create contacts, matters and notes in Docketwise.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/docketwise/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "business-operations",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Docketwise",
        "shortDescription": "Read contacts, matters, invoices and documents; create contacts, matters and notes in Docketwise.",
        "developerName": "UsefulAPI",
        "category": "business-operations",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/docketwise/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List the matters of my firm and show their status.",
          "Show the receipts of the matter for John Doe.",
          "Which invoices are unpaid?"
        ]
      }
    }
  }
}

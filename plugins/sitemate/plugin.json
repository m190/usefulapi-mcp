{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sitemate",
  "version": "1.1.0",
  "description": "Read assets, issues, work orders, inspections and schedules in Sitemate.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/sitemate/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "business-operations",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Sitemate",
        "shortDescription": "Read assets, issues, work orders, inspections and schedules in Sitemate.",
        "developerName": "UsefulAPI",
        "category": "business-operations",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/sitemate/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List the open work orders for the Forklift 3 asset.",
          "Which schedule checks are due in the next 14 days?",
          "Show the issues raised this month with high severity."
        ]
      }
    }
  }
}

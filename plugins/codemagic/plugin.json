{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codemagic",
  "version": "1.40.5",
  "description": "Trigger and inspect Codemagic CI builds, apps and artifacts.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/codemagic/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "devops",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Codemagic",
        "shortDescription": "Trigger and inspect Codemagic CI builds, apps and artifacts.",
        "developerName": "UsefulAPI",
        "category": "devops",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/codemagic/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Did my latest app build succeed or fail?",
          "List the last 10 builds across all my apps.",
          "Get me a download link for the newest build's output file."
        ]
      }
    }
  }
}

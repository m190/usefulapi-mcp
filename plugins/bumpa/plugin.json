{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "bumpa",
  "version": "1.0.0",
  "description": "Read orders and analytics; change shipping status and queue exports in Bumpa.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/bumpa/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "commerce",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Bumpa",
        "shortDescription": "Read orders and analytics; change shipping status and queue exports in Bumpa.",
        "developerName": "UsefulAPI",
        "category": "commerce",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/bumpa/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which orders are paid but not shipped yet?",
          "Show me sales analytics for last week, by product.",
          "Mark order 1042 as SHIPPED."
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dub",
  "version": "1.40.4",
  "description": "Short links with click, lead and sale analytics, customers, tags and the partner programme.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/dub/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "devtools",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Dub",
        "shortDescription": "Short links with click, lead and sale analytics, customers, tags and the partner programme.",
        "developerName": "UsefulAPI",
        "category": "devtools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/dub/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which short links got the most clicks last week?",
          "How many sales came from my links this month?",
          "List my short links tagged 'newsletter'."
        ]
      }
    }
  }
}

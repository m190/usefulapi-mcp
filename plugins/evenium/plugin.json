{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "evenium",
  "version": "1.16.4",
  "description": "Read Evenium events, guests, contacts and hotels; register guests and update contacts and statuses.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/evenium/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "ecommerce",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Evenium",
        "shortDescription": "Read Evenium events, guests, contacts and hotels; register guests and update contacts and statuses.",
        "developerName": "UsefulAPI",
        "category": "ecommerce",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/evenium/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "hub-planner",
  "version": "1.15.5",
  "description": "Read Hub Planner resources, projects, bookings and timesheets; create clients and time entries.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/hub-planner/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "project-management",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Hub Planner",
        "shortDescription": "Read Hub Planner resources, projects, bookings and timesheets; create clients and time entries.",
        "developerName": "UsefulAPI",
        "category": "project-management",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/hub-planner/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Show active projects and the people assigned to them.",
          "Find bookings overlapping next week.",
          "Compare the booked time and actual time entries for a project."
        ]
      }
    }
  }
}

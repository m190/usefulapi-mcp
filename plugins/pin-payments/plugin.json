{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pin-payments",
  "version": "1.11.4",
  "description": "Read Pin Payments charges, refunds, balances, transfers and subscriptions without moving money.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/pin-payments/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "payments",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Pin Payments",
        "shortDescription": "Read Pin Payments charges, refunds, balances, transfers and subscriptions without moving money.",
        "developerName": "UsefulAPI",
        "category": "payments",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/pin-payments/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which charges failed last week?",
          "What are my available and pending balances?",
          "Show my latest deposits and their amounts."
        ]
      }
    }
  }
}

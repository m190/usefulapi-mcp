{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "hypertune",
  "version": "1.40.4",
  "description": "Evaluate and inspect your Hypertune feature flags from your AI assistant.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/hypertune/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "feature-flags",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Hypertune",
        "shortDescription": "Evaluate and inspect your Hypertune feature flags from your AI assistant.",
        "developerName": "UsefulAPI",
        "category": "feature-flags",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/hypertune/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which feature flags exist in my project?",
          "Is the new checkout flag on for a user in the UK?",
          "What would the pricing flag return for a user on the pro plan?"
        ]
      }
    }
  }
}

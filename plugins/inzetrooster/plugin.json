{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "inzetrooster",
  "version": "1.8.0",
  "description": "List shifts and groups, and filter for open shifts in Inzetrooster.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/inzetrooster/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "scheduling",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Inzetrooster",
        "shortDescription": "List shifts and groups, and filter for open shifts in Inzetrooster.",
        "developerName": "UsefulAPI",
        "category": "scheduling",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/inzetrooster/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which shifts are still open this week?",
          "Show every shift for the Ochtendploeg group in May 2026.",
          "Which groups have shifts next month, and how many does each have?"
        ]
      }
    }
  }
}

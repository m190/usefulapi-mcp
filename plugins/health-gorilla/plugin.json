{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "health-gorilla",
  "version": "1.41.0",
  "description": "Query Health Gorilla FHIR patients, conditions, medications and lab results.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/health-gorilla/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "health-data",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Health Gorilla",
        "shortDescription": "Query Health Gorilla FHIR patients, conditions, medications and lab results.",
        "developerName": "UsefulAPI",
        "category": "health-data",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/health-gorilla/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Find the patient record for Jane Smith born 1985-04-12.",
          "What medications is Jane Smith currently prescribed?",
          "List Jane Smith's allergies and immunizations."
        ]
      }
    }
  }
}

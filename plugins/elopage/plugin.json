{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "elopage",
  "version": "1.1.0",
  "description": "Read products, orders, payments, invoices and funnels in Ablefy (elopage).",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/elopage/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "digital-commerce",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Ablefy (elopage)",
        "shortDescription": "Read products, orders, payments, invoices and funnels in Ablefy (elopage).",
        "developerName": "UsefulAPI",
        "category": "digital-commerce",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/elopage/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List the products in my Ablefy account.",
          "Which invoices were issued last month, and which of them are still unpaid?",
          "Look up payment 12345 and tell me its state."
        ]
      }
    }
  }
}

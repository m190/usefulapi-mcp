{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "estuary-flow",
  "version": "1.40.4",
  "description": "Inspect Estuary Flow captures, materializations, collections and stats.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/estuary-flow/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "devops",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Estuary Flow",
        "shortDescription": "Inspect Estuary Flow captures, materializations, collections and stats.",
        "developerName": "UsefulAPI",
        "category": "devops",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/estuary-flow/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which of my data pipelines are currently set up?",
          "How much data did my main pipeline move this week?",
          "Show the recent publication history of my catalog."
        ]
      }
    }
  }

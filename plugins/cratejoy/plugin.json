{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cratejoy",
  "version": "1.24.4",
  "description": "Read Cratejoy subscriptions, customers, orders and shipments; skip or cancel subscriptions.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/cratejoy/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "ecommerce",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Cratejoy",
        "shortDescription": "Read Cratejoy subscriptions, customers, orders and shipments; skip or cancel subscriptions.",
        "developerName": "UsefulAPI",
        "category": "ecommerce",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/cratejoy/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "How many active subscriptions do I have, and which ones are past due?",
          "Show last week's orders and their payment status.",
          "Which shipments are still unshipped?"
        ]
      }
    }
  }
}

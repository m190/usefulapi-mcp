{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dailymed",
  "version": "1.40.4",
  "description": "Search DailyMed drug labels, SPLs, NDCs and packaging.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/dailymed/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "health-data",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "DailyMed",
        "shortDescription": "Search DailyMed drug labels, SPLs, NDCs and packaging.",
        "developerName": "UsefulAPI",
        "category": "health-data",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/dailymed/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Find the label for the drug ibuprofen and its latest version.",
          "What package sizes and codes exist for amoxicillin?",
          "Show the active ingredients listed on the acetaminophen label."
        ]
      }
    }
  }
}

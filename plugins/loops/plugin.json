{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "loops",
  "version": "1.40.4",
  "description": "Manage Loops contacts, mailing lists, and transactional/event emails.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/loops/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "email",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Loops",
        "shortDescription": "Manage Loops contacts, mailing lists, and transactional/event emails.",
        "developerName": "UsefulAPI",
        "category": "email",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/loops/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Look up the contact jane@acme.example and show what we know.",
          "Which mailing lists have I set up in my account?",
          "What custom contact properties have I defined?"
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "deepinfra",
  "version": "1.40.4",
  "description": "Run DeepInfra inference, list models and read account rate limits.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/deepinfra/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "ai-infra",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "DeepInfra",
        "shortDescription": "Run DeepInfra inference, list models and read account rate limits.",
        "developerName": "UsefulAPI",
        "category": "ai-infra",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://usefulapi.io/deepinfra/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Show my spending for the current billing month.",
          "Which models can I use for text embeddings?",
          "Show my deployments and stop the ones that have no traffic."
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "nppes-npi-registry",
  "version": "1.40.4",
  "description": "Look up US healthcare providers and organisations by NPI.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/nppes-npi-registry/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "health-data",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "NPPES NPI Registry",
        "shortDescription": "Look up US healthcare providers and organisations by NPI.",
        "developerName": "UsefulAPI",
        "category": "health-data",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/nppes-npi-registry/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Look up the provider with NPI number 1234567893.",
          "Find cardiologists located in Austin, Texas and show their practice addresses.",
          "Search for clinics and hospitals named Riverside in Ohio."
        ]
      }
    }
  }
}

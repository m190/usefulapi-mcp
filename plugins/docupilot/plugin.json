{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "docupilot",
  "version": "1.8.0",
  "description": "Read templates, schemas, versions, folders, deliveries and merge history in Docupilot.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/docupilot/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "documents",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Docupilot",
        "shortDescription": "Read templates, schemas, versions, folders, deliveries and merge history in Docupilot.",
        "developerName": "UsefulAPI",
        "category": "documents",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/docupilot/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "List my published Docupilot templates.",
          "Which merge fields does my invoice template need?",
          "Show the documents that failed to generate this week."
        ]
      }
    }
  }
}

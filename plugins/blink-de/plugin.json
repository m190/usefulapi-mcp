{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "blink-de",
  "version": "1.1.0",
  "description": "Read employees, locations, planning entries and time records in Blink.",
  "author": {
    "name": "UsefulAPI",
    "email": "support@usefulapi.io",
    "url": "https://usefulapi.io"
  },
  "homepage": "https://usefulapi.io/blink-de/",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "keywords": [
    "time-tracking",
    "mcp",
    "usefulapi"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Blink",
        "shortDescription": "Read employees, locations, planning entries and time records in Blink.",
        "developerName": "UsefulAPI",
        "category": "time-tracking",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://usefulapi.io/blink-de/",
        "privacyPolicyURL": "https://usefulapi.io/privacy/",
        "termsOfServiceURL": "https://usefulapi.io/terms/",
        "defaultPrompt": [
          "Which employees work at location 7, and what is their employee number?",
          "Show the details of time record 99.",
          "Which locations are active in Blink?"
        ]
      }
    }
  }
}
